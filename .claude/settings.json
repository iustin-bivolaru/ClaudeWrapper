{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)"
    ],
    "ask": [
      "Bash(gh pr merge)",
      "Bash(gh pr merge *)",
      "Bash(gh api *pulls/*/merge*)"
    ]
  }
}
