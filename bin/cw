#!/usr/bin/env bash
# cw - Claude Wrapper launcher.
# Runs Claude Code with the orchestrator agent, the cw plugin (workers, reviewer,
# skills, hooks) and the hardened sandbox settings.
# Every claude flag and subcommand works: `cw -c`, `cw -p "..."`, `cw mcp list`.
#
# Model and effort per role. Precedence: CLI flag > environment > config file > default.
#   CW_ORCHESTRATOR_MODEL  (opus)    CW_ORCHESTRATOR_EFFORT (medium)   also: --model / --effort
#   CW_WORKER_MODEL        (sonnet)  CW_WORKER_EFFORT       (medium)
#   CW_REVIEWER_MODEL      (opus)    CW_REVIEWER_EFFORT     (medium)
#   CW_EXPLORER_MODEL      (haiku)   CW_EXPLORER_EFFORT     (low)
#   CW_WORKER_MAX_TURNS    (50)      CW_REVIEWER_MAX_TURNS  (25)       CW_EXPLORER_MAX_TURNS (15)
#   CW_MAX_WORKERS         (3)       CW_NO_BANNER           (unset)
#   CW_PERMISSION_MODE     (claude's default) starting mode: manual | acceptEdits | plan | auto
#                          also: --plan (shortcut for --permission-mode plan), --permission-mode <mode>
# Switch modes during a session with Shift+Tab, as in plain Claude Code.
# Config file: ${XDG_CONFIG_HOME:-~/.config}/cw/config, with KEY=VALUE lines (only CW_* keys are read).
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ $src != /* ]] && src="$dir/$src"
done
CW_HOME="$(cd -P "$(dirname "$src")/.." && pwd)"
export CW_HOME

command -v claude >/dev/null || { echo "cw: 'claude' not found on PATH" >&2; exit 127; }
command -v python3 >/dev/null || { echo "cw: 'python3' is required by the hooks" >&2; exit 127; }

# Claude subcommands that don't start a session: pass straight through.
case "${1:-}" in
  mcp|config|doctor|update|upgrade|install|plugin|plugins|setup-token|migrate-installer|agents|attach|logs|stop|rm|auth|login|logout)
    exec claude "$@" ;;
esac

# --- configuration -------------------------------------------------------------
config_file="${XDG_CONFIG_HOME:-$HOME/.config}/cw/config"
if [ -f "$config_file" ]; then
  while IFS='=' read -r config_key config_value || [ -n "$config_key" ]; do
    config_key="${config_key//[[:space:]]/}"
    [[ $config_key =~ ^CW_[A-Z_]+$ ]] || continue          # ignore comments and non-cw keys
    [ -n "${!config_key+set}" ] && continue                  # environment wins over the file
    config_value="${config_value%%#*}"; config_value="${config_value//[\"\' ]/}"
    export "$config_key=$config_value"
  done < "$config_file"
fi

: "${CW_ORCHESTRATOR_MODEL:=opus}"  "${CW_ORCHESTRATOR_EFFORT:=medium}"
: "${CW_WORKER_MODEL:=sonnet}"      "${CW_WORKER_EFFORT:=medium}"
: "${CW_REVIEWER_MODEL:=opus}"      "${CW_REVIEWER_EFFORT:=medium}"
: "${CW_EXPLORER_MODEL:=haiku}"     "${CW_EXPLORER_EFFORT:=low}"
: "${CW_WORKER_MAX_TURNS:=50}"      "${CW_REVIEWER_MAX_TURNS:=25}"    "${CW_EXPLORER_MAX_TURNS:=15}"
: "${CW_MAX_WORKERS:=3}"
export CW_ORCHESTRATOR_MODEL CW_ORCHESTRATOR_EFFORT CW_WORKER_MODEL CW_WORKER_EFFORT \
       CW_REVIEWER_MODEL CW_REVIEWER_EFFORT CW_EXPLORER_MODEL CW_EXPLORER_EFFORT CW_MAX_WORKERS \
       CW_WORKER_MAX_TURNS CW_REVIEWER_MAX_TURNS CW_EXPLORER_MAX_TURNS

valid_efforts=" low medium high xhigh max "
for effort_variable in CW_ORCHESTRATOR_EFFORT CW_WORKER_EFFORT CW_REVIEWER_EFFORT CW_EXPLORER_EFFORT; do
  [[ $valid_efforts == *" ${!effort_variable} "* ]] || {
    echo "cw: $effort_variable='${!effort_variable}' must be one of:$valid_efforts" >&2; exit 2; }
done
for turns_variable in CW_WORKER_MAX_TURNS CW_REVIEWER_MAX_TURNS CW_EXPLORER_MAX_TURNS CW_MAX_WORKERS; do
  [[ ${!turns_variable} =~ ^[1-9][0-9]*$ ]] || {
    echo "cw: $turns_variable='${!turns_variable}' must be a positive whole number" >&2; exit 2; }
done

# --- plugin overlay: bake the worker/reviewer model + effort into the agent files ----
# Agent frontmatter is static, so cw renders a copy of the plugin per configuration.
# The copy is content-addressed, so concurrent sessions never overwrite each other's files.
overlay_key="$(
  { printf '%s\n' "$CW_WORKER_MODEL" "$CW_WORKER_EFFORT" "$CW_REVIEWER_MODEL" "$CW_REVIEWER_EFFORT" \
      "$CW_EXPLORER_MODEL" "$CW_EXPLORER_EFFORT" "$CW_WORKER_MAX_TURNS" "$CW_REVIEWER_MAX_TURNS" "$CW_EXPLORER_MAX_TURNS"
    cd "$CW_HOME/plugin" && find . -type f -exec cksum {} + | sort -k3; } | cksum | cut -d' ' -f1
)"
plugin_dir="${XDG_CACHE_HOME:-$HOME/.cache}/cw/plugin-$overlay_key"
if [ ! -d "$plugin_dir" ]; then
  mkdir -p "$(dirname "$plugin_dir")"
  staging_dir="$(mktemp -d "$(dirname "$plugin_dir")/staging.XXXXXX")"
  cp -R "$CW_HOME/plugin/." "$staging_dir/"
  set_frontmatter() {  # file key value: replace "key: ..." in the frontmatter only
    python3 - "$1" "$2" "$3" <<'PY'
import re, sys
from pathlib import Path
agent_path, key, value = Path(sys.argv[1]), sys.argv[2], sys.argv[3]
text = agent_path.read_text()
_, frontmatter, body = text.split("---", 2)
frontmatter = re.sub(rf"(?m)^{key}:.*$", f"{key}: {value}", frontmatter)
agent_path.write_text(f"---{frontmatter}---{body}")
PY
  }
  set_frontmatter "$staging_dir/agents/worker.md"   model  "$CW_WORKER_MODEL"
  set_frontmatter "$staging_dir/agents/worker.md"   effort "$CW_WORKER_EFFORT"
  set_frontmatter "$staging_dir/agents/reviewer.md" model  "$CW_REVIEWER_MODEL"
  set_frontmatter "$staging_dir/agents/reviewer.md" effort "$CW_REVIEWER_EFFORT"
  set_frontmatter "$staging_dir/agents/explorer.md" model  "$CW_EXPLORER_MODEL"
  set_frontmatter "$staging_dir/agents/explorer.md" effort "$CW_EXPLORER_EFFORT"
  set_frontmatter "$staging_dir/agents/worker.md"   maxTurns "$CW_WORKER_MAX_TURNS"
  set_frontmatter "$staging_dir/agents/reviewer.md" maxTurns "$CW_REVIEWER_MAX_TURNS"
  set_frontmatter "$staging_dir/agents/explorer.md" maxTurns "$CW_EXPLORER_MAX_TURNS"
  mv "$staging_dir" "$plugin_dir" 2>/dev/null || rm -rf "$staging_dir"   # another session won the race
fi

# --- arguments -------------------------------------------------------------------
wrapper_args=(
  --plugin-dir "$plugin_dir"
  --settings "$CW_HOME/settings/settings.json"
  --agent "cw:orchestrator"
)
# `--plan` is a cw shortcut, not a claude flag: translate it.
passthrough_args=()
for argument in "$@"; do
  if [ "$argument" = "--plan" ]; then passthrough_args+=(--permission-mode plan); else passthrough_args+=("$argument"); fi
done
set -- ${passthrough_args[@]+"${passthrough_args[@]}"}

orchestrator_model="$CW_ORCHESTRATOR_MODEL"
orchestrator_effort="$CW_ORCHESTRATOR_EFFORT"
is_print_mode=false
previous_argument=""
for argument in "$@"; do
  case "$argument" in
    -p|--print|--bg|--background) is_print_mode=true ;;
    --model=*) orchestrator_model="${argument#--model=}" ;;
    --effort=*) orchestrator_effort="${argument#--effort=}" ;;
  esac
  case "$previous_argument" in
    --model) orchestrator_model="$argument" ;;
    --effort) orchestrator_effort="$argument" ;;
  esac
  previous_argument="$argument"
done
case " $* " in *" --model "*|*" --model="*) ;; *) wrapper_args+=(--model "$orchestrator_model") ;; esac
case " $* " in *" --effort "*|*" --effort="*) ;; *) wrapper_args+=(--effort "$orchestrator_effort") ;; esac
start_mode=""
case " $* " in
  *" --permission-mode "*|*" --permission-mode="*) ;;
  *)
    if [ -n "${CW_PERMISSION_MODE:-}" ]; then
      case "$CW_PERMISSION_MODE" in
        manual|acceptEdits|plan|auto) wrapper_args+=(--permission-mode "$CW_PERMISSION_MODE"); start_mode="$CW_PERMISSION_MODE" ;;
        *) echo "cw: CW_PERMISSION_MODE='$CW_PERMISSION_MODE' must be one of: manual acceptEdits plan auto" >&2; exit 2 ;;
      esac
    fi ;;
esac
previous_argument=""
for argument in "$@"; do
  case "$argument" in --permission-mode=*) start_mode="${argument#--permission-mode=}" ;; esac
  [ "$previous_argument" = "--permission-mode" ] && start_mode="$argument"
  previous_argument="$argument"
done

# --- the cw hamster: monochrome, interactive sessions only ------------------------------
if [ -t 1 ] && [ "$is_print_mode" = false ] && [ -z "${CW_NO_BANNER:-}" ]; then
  branch="$(git symbolic-ref --short -q HEAD 2>/dev/null || echo -)"
  cat <<BANNER
 ▗█▖ ▗█▖   cw
 ▟▀███▀▙   orchestrator ${orchestrator_model}/${orchestrator_effort} · workers ${CW_WORKER_MODEL}/${CW_WORKER_EFFORT} 1–${CW_MAX_WORKERS} by size · reviewer ${CW_REVIEWER_MODEL}/${CW_REVIEWER_EFFORT} · explorer ${CW_EXPLORER_MODEL}
 ▜█████▛   sandbox on · secrets guarded · branch ${branch}
  ▘▘ ▝▝    ${start_mode:+mode ${start_mode} · }shift+tab cycles modes (plan · accept edits · default)
BANNER
fi

exec claude "${wrapper_args[@]}" "$@"
