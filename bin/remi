#!/usr/bin/env bash
# remi - launcher.
# Runs Claude Code with the orchestrator agent, the remi plugin (workers, reviewer,
# skills, hooks) and the hardened sandbox settings.
# Every claude flag and subcommand works: `remi -c`, `remi -p "..."`, `remi mcp list`.
# `remi new <folder> ["request"]` starts a new project: creates the folder, then runs remi in it.
#
# Model and effort per role. Precedence: CLI flag > environment > config file > default.
#   REMI_ORCHESTRATOR_MODEL  (opus)    REMI_ORCHESTRATOR_EFFORT (medium)   also: --model / --effort
#   REMI_WORKER_MODEL        (sonnet)  REMI_WORKER_EFFORT       (medium)
#   REMI_REVIEWER_MODEL      (opus)    REMI_REVIEWER_EFFORT     (medium)
#   REMI_WORKER_MAX_TURNS    (50)      REMI_REVIEWER_MAX_TURNS  (25)
#   REMI_MAX_WORKERS         (3)       REMI_NO_BANNER           (unset)
#   REMI_NEW_REPO            (ask)     folder without a git repo: ask | github | local | off
#   REMI_PERMISSION_MODE     (claude's default) starting mode: manual | acceptEdits | plan | auto
#                          also: --plan (shortcut for --permission-mode plan), --permission-mode <mode>
# Switch modes during a session with Shift+Tab, as in plain Claude Code.
# Config file: ${XDG_CONFIG_HOME:-~/.config}/remi/config, with KEY=VALUE lines (only REMI_* keys are read).
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ $src != /* ]] && src="$dir/$src"
done
REMI_HOME="$(cd -P "$(dirname "$src")/.." && pwd)"
export REMI_HOME

command -v claude >/dev/null || { echo "remi: 'claude' not found on PATH" >&2; exit 127; }
command -v python3 >/dev/null || { echo "remi: 'python3' is required by the hooks" >&2; exit 127; }

# Claude subcommands that don't start a session: pass straight through.
case "${1:-}" in
  mcp|config|doctor|update|upgrade|install|plugin|plugins|setup-token|migrate-installer|agents|attach|logs|stop|rm|auth|login|logout)
    exec claude "$@" ;;
  onboard)  # remi's own read-only readiness report for an existing project
    shift
    exec python3 "$REMI_HOME/plugin/hooks/scripts/onboard.py" "$@" ;;
  new)  # new project: create the folder and start there, so the repo bootstrap below applies to it
    shift
    if [ -z "${1:-}" ] || [[ $1 == -* ]]; then
      echo "remi: usage: remi new <folder> [\"request\"] [claude flags]" >&2; exit 2
    fi
    mkdir -p -- "$1"
    cd -- "$1"
    shift
    if enclosing_repo="$(git rev-parse --show-toplevel 2>/dev/null)"; then
      echo "remi: '$PWD' is inside the git repository '$enclosing_repo'; create the new project outside it." >&2
      exit 2
    fi ;;
  ship)  # commit, push, PR and merge for the orchestrator (in a session; gated like the hooks)
    shift
    exec python3 "$REMI_HOME/plugin/hooks/scripts/ship.py" "$@" ;;
esac

# --- configuration -------------------------------------------------------------
config_file="${XDG_CONFIG_HOME:-$HOME/.config}/remi/config"
if [ -f "$config_file" ]; then
  while IFS='=' read -r config_key config_value || [ -n "$config_key" ]; do
    config_key="${config_key//[[:space:]]/}"
    [[ $config_key =~ ^REMI_[A-Z_]+$ ]] || continue          # ignore comments and non-remi keys
    [ -n "${!config_key+set}" ] && continue                  # environment wins over the file
    config_value="${config_value%%#*}"; config_value="${config_value//[\"\' ]/}"
    export "$config_key=$config_value"
  done < "$config_file"
fi

: "${REMI_ORCHESTRATOR_MODEL:=opus}"  "${REMI_ORCHESTRATOR_EFFORT:=medium}"
: "${REMI_WORKER_MODEL:=sonnet}"      "${REMI_WORKER_EFFORT:=medium}"
: "${REMI_REVIEWER_MODEL:=opus}"      "${REMI_REVIEWER_EFFORT:=medium}"
: "${REMI_WORKER_MAX_TURNS:=50}"      "${REMI_REVIEWER_MAX_TURNS:=25}"
: "${REMI_MAX_WORKERS:=3}"           "${REMI_NEW_REPO:=ask}"
case "$REMI_NEW_REPO" in ask|github|local|off) ;; *)
  echo "remi: REMI_NEW_REPO='$REMI_NEW_REPO' must be one of: ask github local off" >&2; exit 2 ;; esac
export REMI_ORCHESTRATOR_MODEL REMI_ORCHESTRATOR_EFFORT REMI_WORKER_MODEL REMI_WORKER_EFFORT \
       REMI_REVIEWER_MODEL REMI_REVIEWER_EFFORT REMI_MAX_WORKERS \
       REMI_WORKER_MAX_TURNS REMI_REVIEWER_MAX_TURNS

valid_efforts=" low medium high xhigh max "
for effort_variable in REMI_ORCHESTRATOR_EFFORT REMI_WORKER_EFFORT REMI_REVIEWER_EFFORT; do
  [[ $valid_efforts == *" ${!effort_variable} "* ]] || {
    echo "remi: $effort_variable='${!effort_variable}' must be one of:$valid_efforts" >&2; exit 2; }
done
for turns_variable in REMI_WORKER_MAX_TURNS REMI_REVIEWER_MAX_TURNS REMI_MAX_WORKERS; do
  [[ ${!turns_variable} =~ ^[1-9][0-9]*$ ]] || {
    echo "remi: $turns_variable='${!turns_variable}' must be a positive whole number" >&2; exit 2; }
done

# --- plugin overlay: bake the worker/reviewer model + effort into the agent files ----
# Agent frontmatter is static, so remi renders a copy of the plugin per configuration.
# The copy is content-addressed, so concurrent sessions never overwrite each other's files.
overlay_key="$(
  { printf '%s\n' "$REMI_WORKER_MODEL" "$REMI_WORKER_EFFORT" "$REMI_REVIEWER_MODEL" "$REMI_REVIEWER_EFFORT" \
      "$REMI_WORKER_MAX_TURNS" "$REMI_REVIEWER_MAX_TURNS"
    cd "$REMI_HOME/plugin" && find . -type f -exec cksum {} + | sort -k3; } | cksum | cut -d' ' -f1
)"
plugin_dir="${XDG_CACHE_HOME:-$HOME/.cache}/remi/plugin-$overlay_key"
if [ ! -d "$plugin_dir" ]; then
  mkdir -p "$(dirname "$plugin_dir")"
  staging_dir="$(mktemp -d "$(dirname "$plugin_dir")/staging.XXXXXX")"
  cp -R "$REMI_HOME/plugin/." "$staging_dir/"
  set_frontmatter() {  # file key value: replace "key: ..." in the frontmatter only
    python3 - "$1" "$2" "$3" <<'PY'
import re, sys
from pathlib import Path
agent_path, key, value = Path(sys.argv[1]), sys.argv[2], sys.argv[3]
text = agent_path.read_text()
_, frontmatter, body = text.split("---", 2)
frontmatter = re.sub(rf"(?m)^{key}:.*$", f"{key}: {value}", frontmatter)
agent_path.write_text(f"---{frontmatter}---{body}")
PY
  }
  set_frontmatter "$staging_dir/agents/worker.md"   model  "$REMI_WORKER_MODEL"
  set_frontmatter "$staging_dir/agents/worker.md"   effort "$REMI_WORKER_EFFORT"
  set_frontmatter "$staging_dir/agents/reviewer.md" model  "$REMI_REVIEWER_MODEL"
  set_frontmatter "$staging_dir/agents/reviewer.md" effort "$REMI_REVIEWER_EFFORT"
  set_frontmatter "$staging_dir/agents/worker.md"   maxTurns "$REMI_WORKER_MAX_TURNS"
  set_frontmatter "$staging_dir/agents/reviewer.md" maxTurns "$REMI_REVIEWER_MAX_TURNS"
  mv "$staging_dir" "$plugin_dir" 2>/dev/null || rm -rf "$staging_dir"   # another session won the race
fi

# --- arguments -------------------------------------------------------------------
wrapper_args=(
  --plugin-dir "$plugin_dir"
  --settings "$REMI_HOME/settings/settings.json"
  --agent "remi:orchestrator"
)
# `--plan` is a remi shortcut, not a claude flag: translate it.
passthrough_args=()
for argument in "$@"; do
  if [ "$argument" = "--plan" ]; then passthrough_args+=(--permission-mode plan); else passthrough_args+=("$argument"); fi
done
set -- ${passthrough_args[@]+"${passthrough_args[@]}"}

orchestrator_model="$REMI_ORCHESTRATOR_MODEL"
orchestrator_effort="$REMI_ORCHESTRATOR_EFFORT"
is_print_mode=false
previous_argument=""
for argument in "$@"; do
  case "$argument" in
    -p|--print|--bg|--background) is_print_mode=true ;;
    --model=*) orchestrator_model="${argument#--model=}" ;;
    --effort=*) orchestrator_effort="${argument#--effort=}" ;;
  esac
  case "$previous_argument" in
    --model) orchestrator_model="$argument" ;;
    --effort) orchestrator_effort="$argument" ;;
  esac
  previous_argument="$argument"
done
case " $* " in *" --model "*|*" --model="*) ;; *) wrapper_args+=(--model "$orchestrator_model") ;; esac
case " $* " in *" --effort "*|*" --effort="*) ;; *) wrapper_args+=(--effort "$orchestrator_effort") ;; esac
start_mode=""
case " $* " in
  *" --permission-mode "*|*" --permission-mode="*) ;;
  *)
    if [ -n "${REMI_PERMISSION_MODE:-}" ]; then
      case "$REMI_PERMISSION_MODE" in
        manual|acceptEdits|plan|auto) wrapper_args+=(--permission-mode "$REMI_PERMISSION_MODE"); start_mode="$REMI_PERMISSION_MODE" ;;
        *) echo "remi: REMI_PERMISSION_MODE='$REMI_PERMISSION_MODE' must be one of: manual acceptEdits plan auto" >&2; exit 2 ;;
      esac
    fi ;;
esac
previous_argument=""
for argument in "$@"; do
  case "$argument" in --permission-mode=*) start_mode="${argument#--permission-mode=}" ;; esac
  [ "$previous_argument" = "--permission-mode" ] && start_mode="$argument"
  previous_argument="$argument"
done

# --- GitHub: required, because remi creates repos, pushes and opens PRs itself -----------
# The launcher runs outside the sandbox, so gh can read its token from the keychain here.
command -v gh >/dev/null || {
  echo "remi: the GitHub CLI 'gh' is required (remi creates repos, pushes and opens PRs). Install it: brew install gh && gh auth login -h github.com" >&2
  exit 1
}
if ! github_response="$(gh api --include --hostname github.com user 2>/dev/null)"; then
  echo "remi: gh is not logged in to github.com (or GitHub is unreachable). Run: gh auth login -h github.com" >&2
  exit 1
fi
github_scopes="$(printf '%s\n' "$github_response" | tr -d '\r' | sed -n 's/^[Xx]-[Oo][Aa][Uu][Tt][Hh]-[Ss][Cc][Oo][Pp][Ee][Ss]: *//p' | head -n 1)"
# Classic OAuth tokens list their scopes; fine-grained tokens send no header, so GitHub enforces them itself.
if [ -n "$github_scopes" ] && ! printf '%s\n' "$github_scopes" | tr ',' '\n' | tr -d ' ' | grep -qx repo; then
  echo "remi: the gh token can't create repos or push (its scopes: $github_scopes). Run: gh auth refresh -h github.com -s repo" >&2
  exit 1
fi

# --- new project: create the repository before the session starts ---------------------
# Claude Code's sandbox only protects a repository that exists when the session starts: a
# .git made mid-session is locked against every sandboxed write, so commits fail. The
# launcher runs as the user, outside the sandbox, so it bootstraps the repo here instead.
if [ "$is_print_mode" = false ] && [ "$REMI_NEW_REPO" != off ] && [ "$PWD" != "$HOME" ] && [ "$PWD" != / ] \
   && ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  project_folder="${PWD##*/}"
  repo_name="$(printf '%s' "$project_folder" | tr -c 'A-Za-z0-9._-' '-')"
  new_repo_choice="$REMI_NEW_REPO"
  # A folder whose subfolders are repositories holds projects; it isn't one. Point to `remi new`.
  if [ "$new_repo_choice" = ask ] && [ -n "$(find . -mindepth 2 -maxdepth 2 -name .git -print -quit 2>/dev/null)" ]; then
    echo "remi: '$project_folder' holds other projects and isn't one itself. To start a new project, exit and run: remi new <folder> [\"request\"]" >&2
    new_repo_choice=off
  fi
  if [ "$new_repo_choice" = ask ]; then
    if [ -t 0 ] && [ -t 1 ]; then
      printf "remi: '%s' is not a git repository, and the session can't create one (the sandbox locks a .git made mid-session).\n" "$project_folder"
      printf "      Create it now: git init, an empty first commit on main and a private GitHub repo '%s'?\n" "$repo_name"
      printf "      [Y] yes · [l] local repository only · [n] no: "
      read -r new_repo_answer || new_repo_answer=n
      case "$new_repo_answer" in
        ""|[Yy]*) new_repo_choice=github ;;
        [Ll]*) new_repo_choice=local ;;
        *) new_repo_choice=off ;;
      esac
    else
      echo "remi: '$project_folder' is not a git repository; remi can't commit here. Run remi interactively once, or set REMI_NEW_REPO=github|local." >&2
      new_repo_choice=off
    fi
  fi
  if [ "$new_repo_choice" != off ]; then
    git init -q -b main
    git commit -q --allow-empty -m "chore: initial commit" || {
      echo "remi: the first commit failed. Set your git identity (git config --global user.name/user.email) and run remi again." >&2
      exit 1
    }
    echo "remi: created a git repository on main with an empty first commit."
    if [ "$new_repo_choice" = github ]; then
      if gh repo create "$repo_name" --private --source . --remote origin --push; then
        echo "remi: created the private GitHub repository '$repo_name'."
      else
        echo "remi: couldn't create the GitHub repository '$repo_name'; the local repository is ready, and remi can create it later in the session." >&2
      fi
    fi
  fi
fi

# --- the remi hamster: monochrome, interactive sessions only ------------------------------
if [ -t 1 ] && [ "$is_print_mode" = false ] && [ -z "${REMI_NO_BANNER:-}" ]; then
  branch="$(git symbolic-ref --short -q HEAD 2>/dev/null || echo -)"
  pyright_hint=""
  command -v pyright-langserver >/dev/null || pyright_hint=" · pyright missing: uv tool install pyright"
  cat <<BANNER
 ▗█▖ ▗█▖   remi
 ▟▀███▀▙   orchestrator ${orchestrator_model}/${orchestrator_effort} · workers ${REMI_WORKER_MODEL}/${REMI_WORKER_EFFORT} 1–${REMI_MAX_WORKERS} by size · reviewer ${REMI_REVIEWER_MODEL}/${REMI_REVIEWER_EFFORT}
 ▜█████▛   sandbox on · secrets guarded · branch ${branch}${pyright_hint}
  ▘▘ ▝▝    ${start_mode:+mode ${start_mode} · }shift+tab cycles modes (plan · accept edits · default)
BANNER
fi

# Hooks and `remi ship` (a Bash command) must find the same per-session state, so pin it now.
export REMI_STATE_DIR="${REMI_STATE_DIR:-${TMPDIR:-/tmp}/remi}"
export PATH="$REMI_HOME/bin:$PATH"   # `remi ship` resolves in the session even if remi isn't installed

exec claude "${wrapper_args[@]}" "$@"
