#!/usr/bin/env bash
# remi - launcher.
# Runs Claude Code with the orchestrator agent, the remi plugin (workers, reviewer, explorer,
# skills, hooks) and the hardened sandbox settings. Models, effort and turn limits per role
# live in the agents' frontmatter (plugin/agents/*.md).
# Every claude flag and subcommand works: `remi -c`, `remi -p "..."`, `remi --model sonnet`, `remi mcp list`.
#   remi --plan        start in plan mode (same as --permission-mode plan)
#   remi onboard       plan-mode session that onboards the current project (onboard skill)
#   REMI_NO_BANNER=1   hide the hamster
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ $src != /* ]] && src="$dir/$src"
done
REMI_HOME="$(cd -P "$(dirname "$src")/.." && pwd)"
export REMI_HOME

command -v claude >/dev/null || { echo "remi: 'claude' not found on PATH" >&2; exit 127; }
command -v python3 >/dev/null || { echo "remi: 'python3' is required by the hooks" >&2; exit 127; }

# Claude subcommands that don't start a session: pass straight through.
case "${1:-}" in
  mcp|config|doctor|update|upgrade|install|plugin|plugins|setup-token|migrate-installer|agents|attach|logs|stop|rm|auth|login|logout)
    exec claude "$@" ;;
  onboard)
    shift
    set -- --permission-mode plan "Onboard this project: load the remi:onboard skill and follow it." "$@" ;;
esac

# `--plan` is a remi shortcut, not a claude flag: translate it.
arguments=()
is_print_mode=false
for argument in "$@"; do
  case "$argument" in
    --plan) arguments+=(--permission-mode plan); continue ;;
    -p|--print|--bg|--background) is_print_mode=true ;;
  esac
  arguments+=("$argument")
done
set -- ${arguments[@]+"${arguments[@]}"}

wrapper_args=(--plugin-dir "$REMI_HOME/plugin" --settings "$REMI_HOME/settings/settings.json" --agent remi:orchestrator)
case " $* " in *" --effort "*|*" --effort="*) ;; *) wrapper_args+=(--effort medium) ;; esac

# --- GitHub: required, because remi creates repos, pushes and opens PRs itself -----------
# The launcher runs outside the sandbox, so gh can read its token from the keychain here.
command -v gh >/dev/null || {
  echo "remi: the GitHub CLI 'gh' is required (remi creates repos, pushes and opens PRs). Install it: brew install gh && gh auth login -h github.com" >&2
  exit 1
}
if ! github_response="$(gh api --include --hostname github.com user 2>/dev/null)"; then
  echo "remi: gh is not logged in to github.com (or GitHub is unreachable). Run: gh auth login -h github.com" >&2
  exit 1
fi
github_scopes="$(printf '%s\n' "$github_response" | tr -d '\r' | sed -n 's/^[Xx]-[Oo][Aa][Uu][Tt][Hh]-[Ss][Cc][Oo][Pp][Ee][Ss]: *//p' | head -n 1)"
# Classic OAuth tokens list their scopes; fine-grained tokens send no header, so GitHub enforces them itself.
if [ -n "$github_scopes" ] && ! printf '%s\n' "$github_scopes" | tr ',' '\n' | tr -d ' ' | grep -qx repo; then
  echo "remi: the gh token can't create repos or push (its scopes: $github_scopes). Run: gh auth refresh -h github.com -s repo" >&2
  exit 1
fi

# --- the remi hamster: monochrome, interactive sessions only ------------------------------
if [ -t 1 ] && [ "$is_print_mode" = false ] && [ -z "${REMI_NO_BANNER:-}" ]; then
  branch="$(git symbolic-ref --short -q HEAD 2>/dev/null || echo -)"
  pyright_hint=""
  command -v pyright-langserver >/dev/null || pyright_hint=" · pyright missing: uv tool install pyright"
  cat <<BANNER
 ▗█▖ ▗█▖   remi
 ▟▀███▀▙   orchestrator opus · workers sonnet (1–3) · reviewer opus · explorer haiku
 ▜█████▛   sandbox on · secrets guarded · branch ${branch}${pyright_hint}
  ▘▘ ▝▝    shift+tab cycles modes (plan · accept edits · default)
BANNER
fi

exec claude "${wrapper_args[@]}" "$@"
